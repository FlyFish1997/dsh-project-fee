{
  "name": "dsh-workspace-fee",
  "version": "0.2.0",
  "private": true,
  "description": "DSH Web 插件：按工作区维度监控 token 消耗与人民币费用，顶部状态栏 + 图形化查询 + 每工作区预警线 + 按日账单。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.2-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "scripts",
    "tests",
    "README.md",
    "LICENSE",
    ".gitignore"
  ],
  "scripts": {
    "probe": "node scripts/probe.mjs",
    "report": "node scripts/report.mjs",
    "test": "node --test --test-isolation=none tests/pricing.test.mjs tests/session-log.test.mjs tests/ledger.test.mjs tests/routes.test.mjs tests/plugin.test.mjs",
    "test:client": "node tests/client-bundle.test.mjs",
    "test:all": "node --test --test-isolation=none \"tests/*.test.mjs\"",
    "test:verify": "node tests/verify-independent/run-all.mjs",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "check:syntax": "node --experimental-vm-modules scripts/check-syntax.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "token",
    "fee",
    "cost",
    "ui"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-rc.1",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
